<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into debug builds only. DUMP permission: only adb shell (Appium) can send the broadcast. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="com.example.mockrules.MockRulesReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.example.mockrules.CONTROL" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
